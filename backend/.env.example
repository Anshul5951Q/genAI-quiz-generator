# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database Configuration
DATABASE_URL=sqlite:///./studyset.db

# Authentication
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Provider Configuration
LLM_PRIMARY_PROVIDER=ollama
LLM_FALLBACK_PROVIDER=groq

# Local Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_NUM_CTX=8192

# Cloud Fallbacks (Optional)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Generation & Validation Settings
MAX_INPUT_CHARACTERS=50000
MAX_UPLOAD_SIZE_MB=15
RESUME_UPLOAD_SIZE_MB=10
CHUNK_SIZE_TOKENS=1000
CHUNK_OVERLAP_TOKENS=150
REQUEST_TIMEOUT_SECONDS=60
MAX_REGENERATION_ATTEMPTS=2

# Upload storage
UPLOAD_DIR=./uploads
