# Environment Configuration for Automatic MCQ Quiz Generator (StudySet)

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database Configuration
DATABASE_URL=sqlite:///./studyset.db

# LLM Configuration (Google Gemini)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended model: gemini-2.5-flash or gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Generation & Validation Settings
MAX_INPUT_CHARACTERS=50000
MAX_UPLOAD_SIZE_MB=15
CHUNK_SIZE_TOKENS=1000
CHUNK_OVERLAP_TOKENS=150
REQUEST_TIMEOUT_SECONDS=60
MAX_REGENERATION_ATTEMPTS=2
